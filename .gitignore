# ==============================================================================
# CareerPilot Root .gitignore
# Covers Node.js Backend, Python FastAPI AI Service, React Frontend & Database
# ==============================================================================

# --- Environment & Secret Credentials ---
# Never commit real credentials, tokens, or private keys
.env
.env*.local
.env.production
.env.staging
# Keep the example template tracked
!.env.example

# --- Dependencies ---
node_modules/
*/node_modules/
package-lock.json.bak

# --- Python & AI Service ---
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Frontend Build Artifacts ---
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/
*.local

# --- User Uploads & Media Files ---
# Prevent uploading user resumes, parsed documents, or candidate data to git
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# --- Database & Docker Volumes ---
*.sqlite
*.sqlite3
*.db
postgres_data/
*.dump
*.sql.gz

# --- Logs & Runtime Output ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editor & Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db

# Visual Studio Code & JetBrains IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

